# Copy to .env. Never commit real secrets. No key below is a real credential.
APP_ENV=development
DATABASE_URL=sqlite:///./rawa_demo.db
# For PostgreSQL/Supabase: postgresql+psycopg://user:pass@host/db
AUTH_MODE=dev
DEV_DOCTOR_TOKEN=dev-doctor-token
SIM_INTERVAL_SECONDS=5
SIM_AUTOLOOP=true
SEED_ON_START=true
CORS_ORIGINS=http://localhost:5173
# Optional unit override (single place, applies everywhere):
# UNIT_HS_CRP=mg/L
